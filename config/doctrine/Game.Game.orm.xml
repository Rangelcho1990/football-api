<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Game\Game" table="game">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="gameTime" column="game_time" type="datetime"  />
        <field name="score" column="score" length="50" nullable="true" />

        <many-to-one field="league" target-entity="App\Domain\League\League">
            <join-column name="league" referenced-column-name="id" nullable="false" on-delete="RESTRICT" />
        </many-to-one>

        <many-to-one field="homeTeam" target-entity="App\Domain\Team\Team">
            <join-column name="home_team" referenced-column-name="id" nullable="false" on-delete="RESTRICT" />
        </many-to-one>

        <many-to-one field="awayTeam" target-entity="App\Domain\Team\Team">
            <join-column name="away_team" referenced-column-name="id" nullable="false" on-delete="RESTRICT" />
        </many-to-one>


        <unique-constraints>
            <unique-constraint columns="home_team,away_team,game_time" name="gameIndex" />
        </unique-constraints>

    </entity>

</doctrine-mapping>
