<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\User\User" table="user" repository-class="App\Infrastructure\Doctrine\UserRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="username" column="username" length="50" nullable="false" />
        <field name="password" column="password" length="500" nullable="false" />
        <field name="isActive" column="isActive" type="boolean" nullable="false" />
        <field name="point" column="point" type="integer" nullable="false" />
        <field name="email" column="email" length="100" />
        <field name="avatar" column="avatar" type="integer" nullable="false" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />


        <unique-constraints>
            <unique-constraint columns="username" name="username" />
            <unique-constraint columns="email" name="email" />
        </unique-constraints>

    </entity>

</doctrine-mapping>
